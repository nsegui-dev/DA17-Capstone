      <aliases enabled='yes' />
      <column caption='Pop Growth' datatype='real' name='[Calculation_3667456731086851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [year] = 2025 THEN [population] END) - &#13;&#10; SUM(IF [year] = 2020 THEN [population] END)) / &#13;&#10; SUM(IF [year] = 2020 THEN [population] END)' />
      </column>
      <column caption='Permit Density' datatype='real' name='[Calculation_3667456731181060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([building_permits]) / SUM([population])) * 1000' />
      </column>
